<?xml version="1.0"?>
<robot name="dual_rm_65">
  <!-- 1. 虚拟关节（匹配URDF的base_link命名规则） -->
  <virtual_joint name="world_to_arm1_base" type="fixed" parent_frame="world" child_link="arm1_base_link" />

  <!-- 2. 规划组定义（严格匹配URDF的连杆/关节命名：Link1~6、fixed_plate_link） -->
  <!-- ################# 右臂（arm1）完整规划组 ################# -->
  <group name="arm1_group">
    <!-- 核心臂6关节（匹配URDF的joint1~6命名） -->
    <joint name="arm1_joint1" />
    <joint name="arm1_joint2" />
    <joint name="arm1_joint3" />
    <joint name="arm1_joint4" />
    <joint name="arm1_joint5" />
    <joint name="arm1_joint6" />
    <!-- 核心臂连杆链（匹配URDF的base_link → fixed_plate_link） -->
    <chain base_link="arm1_base_link" tip_link="arm1_fixed_plate_link" />
  </group>

  <!-- ################# 左臂（arm2）完整规划组 ################# -->
  <group name="arm2_group">
    <joint name="arm2_joint1" />
    <joint name="arm2_joint2" />
    <joint name="arm2_joint3" />
    <joint name="arm2_joint4" />
    <joint name="arm2_joint5" />
    <joint name="arm2_joint6" />
    <chain base_link="arm2_base_link" tip_link="arm2_fixed_plate_link" />
  </group>

  <!-- ################# 机械爪规划组（仅单核心关节） ################# -->
  <group name="arm1_gripper_group">
    <link name="arm1_4C2_baselink" />  <!-- 机械爪基座 -->
    <link name="arm1_4C2_Link1" />     <!-- 机械爪核心主动连杆 -->
    <joint name="arm1_4C2_Joint1" />   <!-- 机械爪唯一控制关节 -->
  </group>

  <group name="arm2_gripper_group">
    <link name="arm2_4C2_baselink" />
    <link name="arm2_4C2_Link1" />
    <joint name="arm2_4C2_Joint1" />
  </group>

  <!-- 双臂总组（可选） -->
  <group name="dual_arm_group">
    <group>arm1_group</group>
    <group>arm2_group</group>
    <group>arm1_gripper_group</group>
    <group>arm2_gripper_group</group>
  </group>

  <!-- 3. 末端执行器定义（匹配URDF的fixed_plate_link连接关系） -->
  <end_effector name="arm1_gripper" 
                group="arm1_gripper_group" 
                parent_group="arm1_group" 
                parent_link="arm1_fixed_plate_link"  
                parent_joint="arm1_joint6"         
                mimic_parent="arm1_joint6"/>

  <end_effector name="arm2_gripper" 
                group="arm2_gripper_group" 
                parent_group="arm2_group" 
                parent_link="arm2_fixed_plate_link"
                parent_joint="arm2_joint6"
                mimic_parent="arm2_joint6"/>

  <!-- 4. 碰撞矩阵（100%匹配URDF的连杆命名：Link1~6、fixed_plate_link） -->
  <!-- 4.1 右臂核心臂相邻连杆（base_link → fixed_plate_link） -->
  <disable_collisions link1="arm1_base_link" link2="arm1_Link1" reason="Adjacent" />
  <disable_collisions link1="arm1_Link1" link2="arm1_Link2" reason="Adjacent" />
  <disable_collisions link1="arm1_Link2" link2="arm1_Link3" reason="Adjacent" />
  <disable_collisions link1="arm1_Link3" link2="arm1_Link4" reason="Adjacent" />
  <disable_collisions link1="arm1_Link4" link2="arm1_Link5" reason="Adjacent" />
  <disable_collisions link1="arm1_Link5" link2="arm1_Link6" reason="Adjacent" />
  <disable_collisions link1="arm1_Link6" link2="arm1_fixed_plate_link" reason="Adjacent" />

  <!-- 4.2 左臂核心臂相邻连杆 -->
  <disable_collisions link1="arm2_base_link" link2="arm2_Link1" reason="Adjacent" />
  <disable_collisions link1="arm2_Link1" link2="arm2_Link2" reason="Adjacent" />
  <disable_collisions link1="arm2_Link2" link2="arm2_Link3" reason="Adjacent" />
  <disable_collisions link1="arm2_Link3" link2="arm2_Link4" reason="Adjacent" />
  <disable_collisions link1="arm2_Link4" link2="arm2_Link5" reason="Adjacent" />
  <disable_collisions link1="arm2_Link5" link2="arm2_Link6" reason="Adjacent" />
  <disable_collisions link1="arm2_Link6" link2="arm2_fixed_plate_link" reason="Adjacent" />

  <!-- 4.3 机械爪相邻连杆（匹配URDF的fixed_plate_link → 4C2_baselink） -->
  <disable_collisions link1="arm1_fixed_plate_link" link2="arm1_4C2_baselink" reason="Adjacent" />
  <disable_collisions link1="arm1_4C2_baselink" link2="arm1_4C2_Link1" reason="Adjacent" />
  <disable_collisions link1="arm2_fixed_plate_link" link2="arm2_4C2_baselink" reason="Adjacent" />
  <disable_collisions link1="arm2_4C2_baselink" link2="arm2_4C2_Link1" reason="Adjacent" />

  <!-- 4.4 双臂底座无碰撞（物理分离） -->
  <disable_collisions link1="arm1_base_link" link2="arm2_base_link" reason="Always" />

  <!-- 5. Home位姿（匹配URDF的关节限位，避免默认姿态碰撞） -->
  <!-- 右臂Home位（抬起，远离底座/左臂） -->
  <group_state name="home" group="arm1_group">
    <joint name="arm1_joint1" value="0.0" />
    <joint name="arm1_joint2" value="-0.8" />  <!-- 更大抬起角度，避免碰底座 -->
    <joint name="arm1_joint3" value="0.0" />
    <joint name="arm1_joint4" value="0.0" />
    <joint name="arm1_joint5" value="0.0" />
    <joint name="arm1_joint6" value="0.0" />
  </group_state>

  <!-- 左臂Home位（抬起，远离右臂） -->
  <group_state name="home" group="arm2_group">
    <joint name="arm2_joint1" value="0.0" />
    <joint name="arm2_joint2" value="0.8" />
    <joint name="arm2_joint3" value="0.0" />
    <joint name="arm2_joint4" value="0.0" />
    <joint name="arm2_joint5" value="0.0" />
    <joint name="arm2_joint6" value="0.0" />
  </group_state>

  <!-- 机械爪Home位（张开） -->
  <group_state name="home" group="arm1_gripper_group">
    <joint name="arm1_4C2_Joint1" value="0.0" />
  </group_state>
  <group_state name="home" group="arm2_gripper_group">
    <joint name="arm2_4C2_Joint1" value="0.0" />
  </group_state>

  <!-- 6. 规划管道配置（适配RM65 6轴臂） -->
  <planning_pipeline name="ompl" group="arm1_group">
    <param name="planning_plugin" value="ompl_interface/OMPLPlanner" />
    <param name="request_adapters" value="default_planner_request_adapters/AddTimeParameterization 
                                          default_planner_request_adapters/FixWorkspaceBounds 
                                          default_planner_request_adapters/FixStartStateBounds 
                                          default_planner_request_adapters/FixStartStateCollision 
                                          default_planner_request_adapters/FixStartStatePathConstraints" />
    <param name="start_state_max_bounds_error" value="0.1" />
    <!-- 适配RM65的规划参数 -->
    <param name="planner_configs" value="RRTConnectkConfigDefault" />
    <param name="default_planner_config" value="RRTConnectkConfigDefault" />
  </planning_pipeline>

  <planning_pipeline name="ompl" group="arm2_group">
    <param name="planning_plugin" value="ompl_interface/OMPLPlanner" />
    <param name="request_adapters" value="default_planner_request_adapters/AddTimeParameterization 
    default_planner_request_adapters/FixWorkspaceBounds 
    default_planner_request_adapters/FixStartStateBounds 
    default_planner_request_adapters/FixStartStateCollision 
    default_planner_request_adapters/FixStartStatePathConstraints" />
    <param name="start_state_max_bounds_error" value="0.1" />
    <param name="planner_configs" value="RRTConnectkConfigDefault" />
    <param name="default_planner_config" value="RRTConnectkConfigDefault" />
  </planning_pipeline>

  <!-- 7. 全局碰撞检测配置（解决mesh重叠误判） -->
  <collision_matrix>
    <default>true</default>
    <distance>0.01</distance>  <!-- 增大容差到10mm，适配STL mesh精度 -->
    <!-- 忽略连接板与机械爪的微小重叠（URDF装配偏移导致） -->
    <pair link1="arm1_fixed_plate_link" link2="arm1_4C2_baselink" value="false" />
    <pair link1="arm2_fixed_plate_link" link2="arm2_4C2_baselink" value="false" />
    <pair link1="arm1_4C2_Link5" link2="arm1_4C2_Link6" value="false" />
    <pair link1="arm2_4C2_Link5" link2="arm2_4C2_Link6" value="false" />
    
    <!-- 机械爪基座与核心臂Link6碰撞 -->
    <pair link1="arm1_4C2_baselink" link2="arm1_Link6" value="false" />
    <pair link1="arm2_4C2_baselink" link2="arm2_Link6" value="false" />
  </collision_matrix>
</robot>