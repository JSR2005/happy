<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rm_example</name>
  <version>0.0.0</version>
  <description>主控制节点 - 协调视觉抓取系统的核心控制器</description>
  <maintainer email="2209099554@qq.com">rm</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ROS2 核心依赖 -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>

  <!-- 消息类型依赖 -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>control_msgs</depend>

  <!-- 官方消息接口 -->
  <depend>rm_ros_interfaces</depend>
  <depend>vision_interfaces</depend>

  <!-- 导纳控制 (力控制) 模块 -->
  <depend>force_control</depend>

  <!-- 夹爪控制模块 -->
  <depend>gripper_module</depend>

  <!-- TF 相关 -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- 图像处理 -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>