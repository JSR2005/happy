<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm_65_description">
    <!-- Arguments -->
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="link6_type" default="Link6_6fb" />

    <!-- Set the link6_type property that will be used by included files -->
    <xacro:property name="link6_type" value="$(arg link6_type)" />

    <!-- Import ros2_control description -->
    <xacro:include filename="rm_65_description.ros2_control.xacro" />
    <xacro:rm_65_description_ros2_control name="FakeSystem"
        initial_positions_file="$(arg initial_positions_file)" />

    <!-- Import arm description -->
    <xacro:include filename="$(find rm_description)/urdf/rm_65_gazebo.urdf.xacro" >
        link6_type:=$(arg link6_type)
    </xacro:include>
</robot>
